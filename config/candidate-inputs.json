{
  "schemaVersion": 1,
  "projectId": "checkout-demo",
  "include": [
    "apps/**/*.ts",
    "apps/checkout-demo/index.html",
    "apps/*/package.json",
    "packages/**/*.ts",
    "packages/*/package.json",
    "config/*.json",
    "package.json",
    "package-lock.json",
    "tsconfig.base.json",
    "vitest.candidate.ts",
